{
  "repoOwner": "",
  "workspace": "",

  "_说明": [
    "这是分享给大家的初始配置。",
    "你不需要手改这个文件 —— 首次运行「启动.bat」时会自动走初始化向导：",
    "  1. 自动检测你的 GitHub 账号",
    "  2. 自动分析每个仓库的类型、构建命令、输出目录",
    "  3. 自动在你的 Cloudflare 账号下创建缺失的数据库/存储",
    "  4. 询问可选的自定义域名",
    "  5. 写入配置",
    "",
    "如果你换了仓库，改下面的 repo 字段即可。",
    "其他字段（project / outputDir / bindings）向导会自动填。"
  ],

  "sites": [
    {
      "id": "blog",
      "label": "静态博客",
      "repo": "fuwari",
      "project": "fuwari-blog",
      "type": "build",
      "buildCommand": "npm run build",
      "installCommand": "npm install",
      "outputDir": "dist",
      "branch": "main",
      "description": "Astro 博客。向导会自动识别框架与构建方式。",
      "bindings": [],
      "patches": ["disable-rss-route", "disable-sitemap", "tolerate-partial-build"]
    },
    {
      "id": "nav",
      "label": "静态导航",
      "repo": "isoziyuan-nav",
      "project": "isoziyuan-nav",
      "type": "static",
      "buildCommand": "",
      "installCommand": "",
      "outputDir": ".",
      "branch": "main",
      "description": "纯静态 + Pages Functions。需要 D1 数据库，向导会自动创建。",
      "bindings": [
        {
          "type": "d1",
          "binding": "NAV_DB",
          "name": "isoziyuan-nav-db",
          "id": "",
          "optional": false
        }
      ]
    },
    {
      "id": "pan",
      "label": "网盘",
      "repo": "isoziyuan-pan",
      "project": "isoziyuan-pan",
      "type": "static",
      "buildCommand": "",
      "installCommand": "",
      "outputDir": ".",
      "branch": "main",
      "description": "纯静态 + Pages Functions。需要 D1 与 R2，向导会自动创建。",
      "bindings": [
        {
          "type": "d1",
          "binding": "DB",
          "name": "isoziyuan-pan-db",
          "id": "",
          "optional": false
        },
        {
          "type": "r2",
          "binding": "R2",
          "name": "forum-uploads",
          "optional": true
        }
      ]
    }
  ],

  "options": {
    "autoInstallDeps": true,
    "cleanInstall": false,
    "verifyAfterDeploy": false,
    "deployTimeoutSec": 600,
    "buildTimeoutSec": 900
  }
}

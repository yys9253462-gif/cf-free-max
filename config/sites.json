      "type": "static",
      "buildCommand": "",
      "installCommand": "",
      "outputDir": ".",
      "branch": "main",
      "protected": true,
      "protectedReason": "该网盘正在正常服务，切勿重新部署覆盖。脚本只做只读检查，不 clone / 不构建 / 不部署。",
      "description": "纯静态 + Pages Functions，依赖 D1 与 R2（🔒 只读保护）",
      "bindings": [
        {
          "type": "d1",

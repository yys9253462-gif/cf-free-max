    {
      "id": "nav",
      "label": "静态导航",
      "repo": "isoziyuan-nav",
      "project": "isoziyuan-nav",
      "domain": "ailxw.com",
      "type": "static",
      "buildCommand": "",
      "installCommand": "",
      "outputDir": ".",

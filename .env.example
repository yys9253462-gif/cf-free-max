# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会提交。

# ============ 必需：二选一 ============

# 方式一（推荐）：API Token
# 在 https://dash.cloudflare.com/profile/api-tokens 创建
# 权限按需勾选，最小权限原则见 README
CF_API_TOKEN=

# 方式二（兼容旧环境）：Global API Key
# 权限过大，仅在 Token 无法覆盖的场景使用
# CF_API_EMAIL=you@example.com
# CF_API_KEY=

# ============ 可选 ============

# 账号 ID。有多个账号时**必须**指定，否则 R2/KV/D1/Pages 操作会失败。
# 获取方式：运行 `cfm whoami`，或登录控制台看 URL 里的 account id
CF_ACCOUNT_ID=

# 调试：设为 1 会打印完整错误堆栈
# CFM_DEBUG=1

# 关闭彩色输出（写日志时有用）
# NO_COLOR=1
